    function Window:Select(tab)

        for _, current in ipairs(self.Tabs) do

            local active =
                current == tab

            current.Page.Visible =
                active

            Tween(
                current.Button,
                {
                    BackgroundColor3 =
                        active
                        and T.Card
                        or T.Bg
                },
                0.12
            )

            current.Bar.Visible =
                active

            current.Text.TextColor3 =
                active
                and T.Text
                or T.Sub

        end

        self.Current = tab

    end

