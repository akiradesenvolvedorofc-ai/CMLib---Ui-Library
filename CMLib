    function Window:SetMinimized(value)

        minimized =
            value == true

        body.Visible =
            not minimized

        Tween(
            main,
            {
                Size =
                    minimized
                    and
                    UDim2.fromOffset(
                        580,
                        48
                    )
                    or
                    UDim2.fromOffset(
                        580,
                        350
                    )
            },
            0.2
        )

    end

    function Window:IsMinimized()
        return minimized
    end

    function Window:Destroy()

        if gui then
            gui:Destroy()
        end

    end

    return Window

end

--==================================================
-- THEME API
--==================================================

function CMLib:SetTheme(theme)

    for key, value in pairs(theme or {}) do

        if T[key] ~= nil then
            T[key] = value
        end

    end

end

function CMLib:GetTheme()

    local copy = {}

    for key, value in pairs(T) do
        copy[key] = value
    end

    return copy

end

