                if options.Callback then

                    task.spawn(
                        options.Callback,
                        state
                    )

                end

            end

            function API:Get()
                return state
            end

            switch.MouseButton1Click:Connect(
                function()

                    API:Set(
                        not state
                    )

                end
            )

            return API

        end

        function Tab:AddSlider(options)

            options =
                options
                or {}

            local min =
                options.Min
                or 0

            local max =
                options.Max
                or 100

            local value =
                options.Default
                or min

            local card =
                Card(58)

            Label({

                Text =
                    options.Name
                    or "",

                Font =
                    T.Bold,

                TextSize = 13,

                Size =
                    UDim2.new(
                        1,
                        -80,
                        0,
                        18
                    ),

                Position =
                    UDim2.fromOffset(
                        14,
                        8
                    ),

                Parent = card

            })

            local number =
                Label({

                    Text =
                        tostring(value),

                    TextColor3 =
                        T.Sub,

                    TextXAlignment =
                        Enum.TextXAlignment.Right,

                    Size =
                        UDim2.fromOffset(
                            60,
                            18
                        ),

                    Position =
                        UDim2.new(
                            1,
                            -74,
                            0,
                            8
                        ),

                    Parent = card

                })

            local track =
                New(
                    "Frame",
                    {

                        Size =
                            UDim2.new(
                                1,
                                -28,
                                0,
                                6
                            ),

                        Position =
                            UDim2.fromOffset(
                                14,
                                38
                            ),

                        BackgroundColor3 =
                            T.Stroke,

                        Parent = card

                    },
                    {
                        New("UICorner", {
                            CornerRadius =
                                UDim.new(
                                    1,
                                    0
                                )
                        })
                    }
                )

            local fill =
                New(
                    "Frame",
                    {

                        Size =
                            UDim2.fromScale(
                                math.clamp(
                                    (
                                        value - min
                                    )
                                    /
                                    math.max(
                                        1,
                                        max - min
                                    ),
                                    0,
                                    1
                                ),
                                1
                            ),

                        BackgroundColor3 =
                            T.Accent,

                        Parent = track

                    },
                    {
                        New("UICorner", {
                            CornerRadius =
                                UDim.new(
                                    1,
                                    0
                                )
                        })
                    }
                )

            local dragging = false

            local function Update(x)

                local percentage =
                    math.clamp(
                        (
                            x
                            - track.AbsolutePosition.X
                        )
                        /
                        math.max(
                            1,
                            track.AbsoluteSize.X
                        ),
                        0,
                        1
                    )

                value =
                    math.floor(
                        min
                        + (max - min)
                        * percentage
                        + 0.5
                    )

                fill.Size =
                    UDim2.fromScale(
                        percentage,
                        1
                    )

                number.Text =
                    tostring(value)

                if options.Callback then

                    task.spawn(
                        options.Callback,
                        value
                    )

                end

            end

            track.InputBegan:Connect(
                function(input)

                    if
                        input.UserInputType
                            == Enum.UserInputType.MouseButton1
                        or
                        input.UserInputType
                            == Enum.UserInputType.Touch
                    then

                        dragging = true

                        Update(
                            input.Position.X
                        )

                    end

                end
            )

            UserInputService.InputChanged:Connect(
                function(input)

                    if
                        dragging
                        and
                        (
                            input.UserInputType
                                == Enum.UserInputType.MouseMovement
                            or
                            input.UserInputType
                                == Enum.UserInputType.Touch
                        )
                    then

                        Update(
                            input.Position.X
                        )

                    end

                end
            )

            UserInputService.InputEnded:Connect(
                function(input)

                    if
                        input.UserInputType
                            == Enum.UserInputType.MouseButton1
                        or
                        input.UserInputType
                            == Enum.UserInputType.Touch
                    then

                        dragging = false

                    end

                end
            )

            return card

        end

