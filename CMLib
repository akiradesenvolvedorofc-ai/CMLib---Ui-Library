            ClearTextOnFocus = false,

            Parent = Frame
        })

    Corner(Input, 8)
    Stroke(
        Input,
        Theme.Stroke,
        1
    )

    local Verify =
        Create("TextButton", {

            Size =
                UDim2.new(
                    0.5,
                    -20,
                    0,
                    40
                ),

            Position =
                UDim2.fromOffset(
                    15,
                    145
                ),

            BackgroundColor3 =
                Theme.Accent,

            BorderSizePixel = 0,

            Text = "Verificar",

            TextColor3 =
                Theme.Text,

            TextSize = 13,

            Font =
                Enum.Font.GothamBold,

            Parent = Frame
        })

    Corner(Verify, 8)

    local GetKey =
        Create("TextButton", {

            Size =
                UDim2.new(
                    0.5,
                    -20,
                    0,
                    40
                ),

            Position =
                UDim2.new(
                    0.5,
                    5,
                    0,
                    145
                ),

            BackgroundColor3 =
                Theme.Secondary,

            BorderSizePixel = 0,

            Text = "Get Key",

            TextColor3 =
                Theme.Text,

            TextSize = 13,

            Font =
                Enum.Font.GothamBold,

            Parent = Frame
        })

    Corner(GetKey, 8)
    Stroke(
        GetKey,
        Theme.Stroke,
        1
    )

    local Status =
        Create("TextLabel", {

            Size =
                UDim2.new(
                    1,
                    -30,
                    0,
                    35
                ),

            Position =
                UDim2.fromOffset(
                    15,
                    200
                ),

            BackgroundTransparency = 1,

            Text = "",

            TextColor3 =
                Theme.SubText,

            TextSize = 12,

            Font =
                Enum.Font.Gotham,

            TextXAlignment =
                Enum.TextXAlignment.Left,

            Parent = Frame
        })

    GetKey.MouseButton1Click:Connect(
        function()

            if Config.GetKey then

                local Success, Result =
                    pcall(
                        Config.GetKey
                    )

                if Success and Result then

                    Status.Text =
                        tostring(Result)

                    Status.TextColor3 =
                        Theme.Success

                else

                    Status.Text =
                        "Não foi possível obter a Key."

                    Status.TextColor3 =
                        Theme.Error

                end

            else

                Status.Text =
                    "Configure Config.GetKey."

                Status.TextColor3 =
                    Theme.SubText

            end

        end
    )

    Verify.MouseButton1Click:Connect(
        function()

            local Key =
                tostring(
                    Input.Text
                )

            if Key == "" then

                Status.Text =
                    "Digite uma Key."

                Status.TextColor3 =
                    Theme.Error

                return
            end

            local Valid = false

            if Config.Validate then

                local Success, Result =
                    pcall(
                        Config.Validate,
                        Key
                    )

                if Success then
                    Valid = Result == true
                end

            elseif Config.Keys then

                for _, AllowedKey in
                    ipairs(Config.Keys) do

                    if Key ==
                        tostring(
                            AllowedKey
                        ) then

                        Valid = true
                        break

                    end

                end

            end

            if Valid then

                Status.Text =
                    "Key válida!"

                Status.TextColor3 =
                    Theme.Success

                task.wait(0.35)

                KeyGui:Destroy()

                if Config.OnSuccess then
                    Config.OnSuccess(
                        Key
                    )
                end

            else

                Status.Text =
                    "Key inválida."

                Status.TextColor3 =
                    Theme.Error

                if Config.OnFailure then
                    Config.OnFailure(
                        Key
                    )
                end

            end

        end
    )

    return {

        Gui = KeyGui,

        Destroy = function()
            KeyGui:Destroy()
        end

    }

end

