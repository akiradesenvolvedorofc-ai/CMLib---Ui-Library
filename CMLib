    function Window:SetLauncherSize(Size)

        if typeof(Size) ~= "number" then
            return
        end

        Size = math.clamp(
            Size,
            40,
            120
        )

        LauncherSize = Size

        Launcher.Size =
            UDim2.fromOffset(
                Size,
                Size
            )

        LauncherImage.Size =
            UDim2.new(
                1,
                -8,
                1,
                -8
            )

    end

    function Window:SetLauncherPosition(Position)

        if typeof(Position) ==
            "UDim2" then

            Launcher.Position =
                Position

        end

    end

    function Window:SetMinimized(State)

        State = State == true

        Minimized = State

        if State then

            Main.Visible = false

            Launcher.Visible = true

            Launcher.Size =
                UDim2.fromOffset(
                    0,
                    0
                )

            TweenService:Create(

                Launcher,

                TweenInfo.new(
                    0.22,
                    Enum.EasingStyle.Back,
                    Enum.EasingDirection.Out
                ),

                {
                    Size =
                        UDim2.fromOffset(
                            LauncherSize,
                            LauncherSize
                        )
                }

            ):Play()

        else

            Launcher.Visible = false

            Main.Visible = true

        end

    end

    function Window:IsMinimized()

        return Minimized

    end

    Minimize.MouseButton1Click:Connect(function()

        Window:SetMinimized(true)

    end)

    Launcher.MouseButton1Click:Connect(function()

        Window:SetMinimized(false)

    end)

