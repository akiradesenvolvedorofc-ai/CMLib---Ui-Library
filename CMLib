--==================================================
-- HELPERS
--==================================================

local function New(class, props, children)

    local object = Instance.new(class)

    for property, value in pairs(props or {}) do
        object[property] = value
    end

    for _, child in ipairs(children or {}) do
        child.Parent = object
    end

    return object
end

local function Corner(radius)

    return New("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    })

end

local function Stroke(color)

    return New("UIStroke", {
        Color = color or T.Stroke,
        Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    })

end

local function Tween(object, properties, duration)

    TweenService:Create(
        object,
        TweenInfo.new(
            duration or 0.15,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        properties
    ):Play()

end

local function Label(properties)

    properties.BackgroundTransparency = 1
    properties.Font = properties.Font or T.Font
    properties.TextColor3 = properties.TextColor3 or T.Text
    properties.TextSize = properties.TextSize or 13
    properties.TextXAlignment =
        properties.TextXAlignment
        or Enum.TextXAlignment.Left

    return New("TextLabel", properties)

end

--==================================================
-- GUI PARENT
--==================================================

local function GetGuiParent()

    local ok, hui = pcall(function()

        if gethui then
            return gethui()
        end

    end)

    if ok and hui then
        return hui
    end

    local ok2, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)

    if ok2 and coreGui then
        return coreGui
    end

    return Players.LocalPlayer:WaitForChild("PlayerGui")

end

--==================================================
-- CREATE GUI
--==================================================

local function MakeGui(name)

    local parent = GetGuiParent()

    local old = parent:FindFirstChild(name)

    if old then
        old:Destroy()
    end

    return New("ScreenGui", {
        Name = name,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = parent
    })

end

--==================================================
-- SCALE
--==================================================

local function Fit(main, width, height)

    local camera = workspace.CurrentCamera

    local viewport =
        camera and camera.ViewportSize
        or Vector2.new(1280, 720)

    local scale = math.min(
        1,
        (viewport.X - 20) / width,
        (viewport.Y - 20) / height
    )

    New("UIScale", {
        Scale = scale,
        Parent = main
    })

end

--==================================================
-- DRAG
--==================================================

local function Draggable(handle, target)

    local dragging = false
    local startPosition
    local startFramePosition

    handle.InputBegan:Connect(function(input)

        if
            input.UserInputType
                == Enum.UserInputType.MouseButton1
            or
            input.UserInputType
                == Enum.UserInputType.Touch
        then

            dragging = true

            startPosition =
                input.Position

            startFramePosition =
                target.Position

        end

    end)

    UserInputService.InputChanged:Connect(function(input)

        if
            dragging
            and
            (
                input.UserInputType
                    == Enum.UserInputType.MouseMovement
                or
                input.UserInputType
                    == Enum.UserInputType.Touch
            )
        then

            local delta =
                input.Position
                - startPosition

            target.Position =
                UDim2.new(
                    startFramePosition.X.Scale,
                    startFramePosition.X.Offset + delta.X,

                    startFramePosition.Y.Scale,
                    startFramePosition.Y.Offset + delta.Y
                )

        end

    end)

    UserInputService.InputEnded:Connect(function(input)

        if
            input.UserInputType
                == Enum.UserInputType.MouseButton1
            or
            input.UserInputType
                == Enum.UserInputType.Touch
        then

            dragging = false

        end

    end)

end

--==================================================
-- CLIPBOARD
--==================================================

local function Copy(text)

    if not text or text == "" then
        return false
    end

    local ok = pcall(function()

        if setclipboard then
            setclipboard(text)
        elseif toclipboard then
            toclipboard(text)
        else
            error("Clipboard unavailable")
        end

    end)

    return ok

end

--==================================================
-- JNKIE ADAPTER
--==================================================

local Junkie = {
    Config = nil,
    SDK = nil
}

function Junkie:Configure(config)

    self.Config = config or {}

end

--==================================================
-- LOAD JNKIE SDK
--==================================================

function Junkie:LoadSDK()

    if self.SDK then
        return true, self.SDK
    end

    local config = self.Config

    if not config then
        return false, "JNKIE NÃO CONFIGURADO"
    end

    local sdkURL = config.SDKURL

    if not sdkURL or sdkURL == "" then
        return false, "SDKURL NÃO CONFIGURADA"
    end

    local ok, result = pcall(function()

        return loadstring(
            game:HttpGet(sdkURL)
        )()

    end)

    if not ok then

        return false,
            "ERRO AO CARREGAR JNKIE SDK"

    end

    self.SDK = result

    return true, result

end

--==================================================
-- GET KEY
--==================================================

function Junkie:GetKeyLink()

    local config = self.Config

    if not config then
        return false, "JNKIE NÃO CONFIGURADO"
    end

    -- API personalizada fornecida pelo usuário
    if config.GetKey then

        local ok, result =
            pcall(
                config.GetKey,
                config
            )

        if ok and result then
            return true, tostring(result)
        end

    end

    -- SDK
    local loaded, sdk =
        self:LoadSDK()

    if not loaded then
        return false, sdk
    end

    if type(sdk) ~= "table" then
        return false, "JNKIE SDK INVÁLIDO"
    end

    local method =
        sdk.get_key_link
        or sdk.GetKeyLink
        or sdk.getKeyLink

    if not method then
        return false, "GET KEY NÃO ENCONTRADO NO SDK"
    end

    local ok, result =
        pcall(
            method,
            {
                service = config.Service,
                identifier = config.Identifier,
                provider = config.Provider
            }
        )

    if not ok then
        return false, tostring(result)
    end

    if type(result) == "table" then

        result =
            result.url
            or result.link
            or result.key_link
            or result.keyLink

    end

    if result then
        return true, tostring(result)
    end

    return false, "JNKIE NÃO RETORNOU O LINK"

end

--==================================================
-- VALIDATE KEY
--==================================================

function Junkie:ValidateKey(key)

    local config = self.Config

    if not config then
        return false, "JNKIE NÃO CONFIGURADO"
    end

    if not key or key == "" then
        return false, "DIGITE UMA KEY"
    end

    -- API personalizada
    if config.Validate then

        local ok, result =
            pcall(
                config.Validate,
                key,
                config
            )

        if not ok then
            return false, tostring(result)
        end

        if type(result) == "boolean" then

            return result,
                result
                and "KEY VALID"
                or "KEY INVALID"

        end

        if type(result) == "table" then

            local valid =
                result.valid
                or result.success
                or result.authorized

            return valid == true,
                tostring(
                    result.message
                    or
                    (
                        valid
                        and "KEY VALID"
                        or "KEY INVALID"
                    )
                )

        end

    end

    -- SDK JNKIE
    local loaded, sdk =
        self:LoadSDK()

    if not loaded then
        return false, sdk
    end

    if type(sdk) ~= "table" then
        return false, "JNKIE SDK INVÁLIDO"
    end

    local method =
        sdk.check_key
        or sdk.validate_key
        or sdk.ValidateKey
        or sdk.validate

    if not method then
        return false, "VALIDAÇÃO NÃO ENCONTRADA NO SDK"
    end

    local ok, result =
        pcall(
            method,
            {
                service = config.Service,
                identifier = config.Identifier,
                provider = config.Provider,
                key = tostring(key)
            }
        )

    if not ok then

        -- Alguns SDKs recebem apenas a key
        local retryOK, retryResult =
            pcall(
                method,
                tostring(key)
            )

        if not retryOK then
            return false, tostring(result)
        end

        result = retryResult

    end

    if type(result) == "boolean" then

        return result,
            result
            and "KEY VALID"
            or "KEY INVALID"

    end

    if type(result) == "table" then

        local valid =
            result.valid
            or result.success
            or result.authorized
            or result.isValid

        return valid == true,
            tostring(
                result.message
                or
                (
                    valid
                    and "KEY VALID"
                    or "KEY INVALID"
                )
            )

    end

    return false, "RESPOSTA INVÁLIDA DO JNKIE"

end

